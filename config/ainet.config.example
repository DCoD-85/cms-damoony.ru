{
  "allowed_domains": [
    "api.openverse.engineering",
    "api.unsplash.com",
    "images.unsplash.com",
    "api.pexels.com",
    "images.pexels.com",
    "commons.wikimedia.org",
    "upload.wikimedia.org",
    "ru.wikipedia.org",
    "en.wikipedia.org",
    "api.github.com"
  ],
  "providers": {
    "default": "openverse",
    "keys": {
      "unsplash": "",
      "pexels": ""
    }
  },
  "timeouts": {
    "connect": 5,
    "read": 10
  },
  "limits": {
    "max_size": 10485760,
    "max_redirects": 3,
    "rate_per_min": 30,
    "min_image_dimension": 200
  },
  "cache_ttl_days": 7,
  "block_private_ips": true,
  "allowed_schemes": ["http", "https"],
  "allowed_ports": [80, 443],
  "allowed_mimes": [
    "image/jpeg",
    "image/png",
    "image/gif",
    "image/webp",
    "image/svg+xml"
  ]
}