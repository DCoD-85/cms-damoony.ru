# ================================================================
# Damoony Engine — .gitignore (v2.0.0, audit-clean)
# Правило: один паттерн — одно место. Без дублей.
# ================================================================

# --- Composer / vendor ---
/vendor/
/vendor-dev/
/composer.phar
/bin/composer.phar

# --- PHP tooling caches ---
.phpunit.cache/
.phpunit.result.cache
.php-cs-fixer.cache
/_dev/var/

# --- IDE ---
/.idea/
/.vscode/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- PHP build artifacts ---
*.log
phpstan.neon.local
/build/
/coverage/

# --- Secrets / runtime ---
/secure/
/var/
/storage/
env.php
.env
.env.local

# --- Prod configs (содержат секреты) ---
/config/admin.config
/config/site.config
/config/engine.config
/config/agent.config
/config/ainet.config

# --- Test artifacts ---
/tests/fixtures/scenarios/**/actual/
/tests/fixtures/scenarios/**/diff/

# --- Временное ---
/tmp/
*.tmp

# --- Dev-маркеры ---
/.dev
/_dev/.dev

# --- Аудит-доки (архив, не пушим) ---
/_devdocoldpro/
/_doc/_audit-snapshot.txt

# --- Карантин (runtime, создаётся CLI) ---
app/*_trash_*

# --- Python / ai_agent ---
/venv/
/ai_agent/.session/
/ai_agent/__pycache__/

# --- AI content (runtime, вне webroot, только через CLI content:store) ---
/content/

# --- AI media (runtime) ---
/www/media/*/*/
!/www/media/*/skin/
!/www/media/admin/
!/www/media/shared/
/www/media/.trash/

# --- E2E test-domain (генерируется brain.py) ---
/app/damoony3test.ru/

# --- Локальный мусор CLI ---
/bin/*.txt
# --- Эфемерные E2E-домены, генерируемые brain.py (не трекаются) ---
# Формат: <allias=agentN|siteNNNN>.<domain из whitelist>
/www/media/agent*.damoony.ru/
/www/media/agent*.damoony3.ru/
/www/media/agent*.damoony3test.ru/
/www/media/site[0-9]*.damoony.ru/
/www/media/site[0-9]*.damoony3.ru/
/www/media/site[0-9]*.damoony3test.ru/

# --- AI edit sessions (runtime) ---
/app/.sess_*/
/app/_trash_sess_*/

# Session media copies (runtime, AIUI preview)
/www/media/.sess_*/
/www/media/_trash_sess_*/

# --- AIUI sessions (runtime) ---
/app/.sess_*/
/www/media/.sess_*/
/app/_trash_sess_*/
/www/media/_trash_sess_*/
_dev/api.stub.php
