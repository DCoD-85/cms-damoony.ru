{
    "name": "damoony/engine",
    "description": "Damoony engine — modular PHP 8.4 framework for multi-domain multi-allias sites",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "psr/log": "^3.0",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^1.11",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Damoony\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Damoony\\Tests\\": "_dev/tests/"
        }
    },
    "scripts": {
        "test": "phpunit -c _dev/phpunit.xml",
        "stan": "phpstan analyse -c _dev/phpstan.neon --memory-limit=1G",
        "cs": "PHP_CS_FIXER_IGNORE_ENV=1 php-cs-fixer fix --config=_dev/.php-cs-fixer.php --dry-run --diff",
        "cs-fix": "PHP_CS_FIXER_IGNORE_ENV=1 php-cs-fixer fix --config=_dev/.php-cs-fixer.php",
        "check": ["@stan", "@cs", "@test"]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}