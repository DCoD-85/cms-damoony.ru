{
    "name": "damoony/engine",
    "description": "Damoony engine — modular PHP 8.4 framework for multi-domain multi-allias sites",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "psr/log": "^3.0",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.11",
        "friendsofphp/php-cs-fixer": "^3.50"
    },
    "autoload": {
        "psr-4": {
            "Damoony\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Damoony\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse src --level=8",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "check": ["@stan", "@cs", "@test"]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}