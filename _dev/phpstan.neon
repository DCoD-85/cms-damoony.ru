parameters:
    level: 8
    paths:
        - ../src
        - ../bin
        - ../www
    excludePaths:
        - ../www/stubs/* (?)
        - ../www/request.php (?)
        - ../www/api/* (?)
        - ../www/packager.php (?)
        - ../www/content.php (?)
        - ../www/router.php (?)
        - ../www/forms.php (?)
    tmpDir: ../var/phpstan
    reportUnmatchedIgnoredErrors: true
    treatPhpDocTypesAsCertain: true
    ignoreErrors: []