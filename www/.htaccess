RewriteEngine On
RewriteBase /

# /content/* — через content.php (front controller отдачи с auth-check)
RewriteRule ^content/ content.php [L,QSA]

# AIUI: Красивые URL для превью (/admin/preview/{tab_id}/{path})
RewriteRule ^admin/preview/([a-f0-9]+)/?(.*)$ admin/aipreview.php?tab=$1&path=/$2 [L,QSA]

# /admin/ и всё внутри — принудительно в admin/index.php, КРОМЕ реальных файлов (aiui.php, ai_edit.php)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^admin(/.*)?$ admin/index.php [L,QSA]

# реальные файлы со статикой — отдаём как есть
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule \.(css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|map)$ - [L]

# POST формы
RewriteRule ^submit$ forms.php [L,QSA]

# всё остальное — в front controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?%{QUERY_STRING} [L]