RewriteEngine On
RewriteBase /

# /admin/ — не переписывать, отдать DirectoryIndex (www/admin/index.php)
RewriteRule ^admin/ - [L]

# --- dev: прямой доступ к /tests/ ---
RewriteCond %{REQUEST_FILENAME} ^(.*)tests(.*)$
RewriteRule ^(.*)$ index.php?route=tests&%{QUERY_STRING} [NC,L]

# реальные файлы со статикой — отдаём как есть
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule \.(css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|map)$ - [L]

# всё остальное — в front controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?%{QUERY_STRING} [L]